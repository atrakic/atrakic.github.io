package main

import "strings"

templ index(name string) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta http-equiv="Content-Type" content="text/html; charset=windows-1252"/>
			<title>{ name }</title>
			<link rel="stylesheet" href="assets/style.css"/>
		</head>
		<body>
			<table class="layout" border="0" width="100%" height="100%" cellspacing="0" cellpadding="0">
				<tr>
					<td width="100%" colspan="3" height="10%">&nbsp;</td>
				</tr>
				<tr>
					<td width="33%">
						<p class="name" align="right">
							<span>{ strings.ToLower(name) }&nbsp;&nbsp;</span>
						</p>
					</td>
					<td width="33%">
						<p class="social-links">
							<a href="https://github.com/atrakic" target="_blank">github</a><br/>
							<a href="https://twitter.com/atrakic" target="_blank">twitter</a><br/>
						</p>
					</td>
					<td width="34%">&nbsp;</td>
				</tr>
				<tr>
					<td width="34%" height="10%"></td>
					<td width="33%" height="10%" valign="top">
						<p class="about" align="right">
							<br/>
							... what about? &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
							&nbsp;
						</p>
					</td>
					<td width="33%" height="10%" valign="top">
						<p class="links">
							<a href="https://atrakic.github.io/static-site/blog/" target="_blank">blog</a><br/>
							<a href="https://atrakic.github.io/helm-charts/" target="_blank">helm charts</a>
						</p>
					</td>
				</tr>
			</table>
		</body>
	</html>
}
